# Copie ce fichier en .env.local et remplis les valeurs.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète : ne jamais la mettre dans le code du navigateur ni dans GitHub
SUPABASE_SERVICE_ROLE_KEY=

# Domaine principal. En local : localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Stripe (dashboard.stripe.com > Développeurs)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
